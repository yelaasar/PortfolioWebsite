# The contact form sends through every channel configured below, and succeeds
# if ANY of them lands. Configure one or both. If none are set the form still
# renders and fails gracefully, offering its mailto fallback.
#
# Nothing here costs money. Both providers' free tiers are ample at this volume.
# None of these may be prefixed NEXT_PUBLIC_ — that ships the secret in the
# client bundle to every visitor.

# --- Telegram: instant push to your phone --------------------------------
# Free, official, no card. Setup:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#   2. It replies with the token below.
#   3. Send your new bot any message (it cannot message you first).
#   4. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#      result[0].message.chat.id — that is TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email: the archive, and one-tap Reply to the lead --------------------
# Resend free tier is 3,000/month, 100/day. https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives enquiries. On Resend's free tier (no verified domain)
# this MUST be the address that owns the Resend account, or delivery is
# rejected. Free-tier mail lands in spam periodically — check that folder.
CONTACT_TO_EMAIL=

# Sender address. Stays onboarding@resend.dev until a domain is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev
