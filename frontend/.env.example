# Resend API key — https://resend.com/api-keys
# Secret. Never prefix with NEXT_PUBLIC_ or it ships in the client bundle.
RESEND_API_KEY=

# Inbox that receives contact-form leads.
# On Resend's free tier (no verified domain) this MUST be the address that
# owns the Resend account, or delivery is rejected.
CONTACT_TO_EMAIL=

# Sender address. Stays onboarding@resend.dev until a domain is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev
